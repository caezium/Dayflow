<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ATSApplicationFontsPath</key>
	<string>.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Allow plain-HTTP to user-configured local/self-hosted LLM endpoints
		     (LAN, Tailscale 100.x, LiteLLM, LM Studio, etc.). Dayflow only ever
		     connects to endpoints the user enters; this opens no inbound access.
		     NOTE: do NOT add NSAllowsLocalNetworking here — on modern macOS that
		     key being present makes the system IGNORE NSAllowsArbitraryLoads, and
		     it doesn't cover Tailscale's 100.64.0.0/10 range. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>CFBundleShortVersionString</key>
	<string>2.1.1</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>teleportlabs.com.Dayflow</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>dayflow</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>120</string>
	<key>DayflowBackendURL</key>
	<string>$(DAYFLOW_BACKEND_URL)</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Dayflow uses screen access to create your timeline. Recordings stay on your Mac and you can pause or delete them anytime.</string>
	<key>SUAllowsAutomaticUpdates</key>
	<false/>
	<key>SUAutomaticallyUpdate</key>
	<false/>
	<key>SUEnableAutomaticChecks</key>
	<false/>
	<key>SUEnableInstallerLauncherService</key>
	<false/>
	<key>SUFeedURL</key>
	<string>https://dayflow.so/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>lf33Kn/Gx26j9zfGtsNNc6Lk2QTBHyXkFxxwnsXmdYA=</string>
	<key>SUScheduledCheckInterval</key>
	<integer>3600</integer>
	<key>UIAppFonts</key>
	<array>
		<string>InstrumentSerif-Regular.ttf</string>
		<string>InstrumentSerif-Italic.ttf</string>
		<string>Figtree-VariableFont_wght.ttf</string>
		<string>Figtree-Italic-VariableFont_wght.ttf</string>
		<string>Nunito-VariableFont_wght.ttf</string>
		<string>Nunito-Italic-VariableFont_wght.ttf</string>
	</array>
</dict>
</plist>
